# ============================================
# AgriPulse Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# DO NOT commit your .env to version control.
# ============================================

# ─── Server ──────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database (PostgreSQL via Prisma) ────────
DATABASE_URL=postgresql://user:password@localhost:5432/agripulse?schema=public

# ─── JWT ─────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_COOKIE_NAME=agripulse_refresh_token

# ─── Firebase (Phone OTP Auth) ──────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# ─── Cloudinary (Image Uploads) ─────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=agripulse

# ─── data.gov.in Agmarknet API ──────────────
DATA_GOV_API_KEY=your_data_gov_api_key
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ─── Rate Limiting ──────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Bcrypt ─────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── Pagination Defaults ────────────────────
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ─── SMS Provider (Placeholder) ─────────────
SMS_PROVIDER=placeholder
SMS_API_KEY=your_sms_api_key

# ─── Push Notifications (Placeholder) ───────
PUSH_PROVIDER=placeholder
FCM_SERVER_KEY=your_fcm_server_key

# ─── Weather API (Placeholder) ──────────────
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ─── Transport Cost Estimation ──────────────
TRANSPORT_COST_PER_KM_PER_QUINTAL=2.5
